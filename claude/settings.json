{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "n=${CLAUDE_PROJECT_DIR:-$PWD}; d=/dev/$(ps -o tty= -p ${CLAUDE_PID:-$PPID} 2>/dev/null | tr -d ' '); [ -w \"$d\" ] && printf '\\033]0;🌀 %s\\007' \"${n##*/}\" > \"$d\"; exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $HOME/.claude/mute ] || afplay /System/Library/Sounds/Submarine.aiff >/dev/null 2>&1 &"
          },
          {
            "type": "command",
            "command": "n=${CLAUDE_PROJECT_DIR:-$PWD}; d=/dev/$(ps -o tty= -p ${CLAUDE_PID:-$PPID} 2>/dev/null | tr -d ' '); [ -w \"$d\" ] && printf '\\033]0;🔴 %s\\007\\a' \"${n##*/}\" > \"$d\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $HOME/.claude/mute ] || afplay /System/Library/Sounds/Glass.aiff >/dev/null 2>&1 &"
          },
          {
            "type": "command",
            "command": "n=${CLAUDE_PROJECT_DIR:-$PWD}; d=/dev/$(ps -o tty= -p ${CLAUDE_PID:-$PPID} 2>/dev/null | tr -d ' '); [ -w \"$d\" ] && printf '\\033]0;💤 %s\\007\\a' \"${n##*/}\" > \"$d\"; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=/dev/$(ps -o tty= -p ${CLAUDE_PID:-$PPID} 2>/dev/null | tr -d ' '); [ -w \"$d\" ] && printf '\\033]0;\\007' > \"$d\"; exit 0"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "effortLevel": "high",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
