{
  "agentPushNotifEnabled": true,
  "editorMode": "vim",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ -f $HOME/.claude/mute ] || bash \"$HOME/.claude/duck-play.sh\" /System/Library/Sounds/Submarine.aiff >/dev/null 2>&1 &",
            "type": "command"
          },
          {
            "command": "bash \"$HOME/.claude/bell.sh\"",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ -f $HOME/.claude/mute ] || bash \"$HOME/.claude/duck-play.sh\" /System/Library/Sounds/Glass.aiff >/dev/null 2>&1 &",
            "type": "command"
          },
          {
            "command": "bash \"$HOME/.claude/bell.sh\"",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "defaultMode": "auto"
  },
  "preferredNotifChannel": "notifications_disabled",
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "type": "command"
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "worktree": {
    "baseRef": "fresh"
  }
}
