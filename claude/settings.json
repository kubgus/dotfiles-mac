{
  "agentPushNotifEnabled": true,
  "editorMode": "vim",
  "enabledPlugins": {
    "kubgus@kubgus": true
  },
  "extraKnownMarketplaces": {
    "kubgus": {
      "source": {
        "path": "/Users/kubgus/Dotfiles/claude/plugins",
        "source": "directory"
      }
    }
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "defaultMode": "auto"
  },
  "preferredNotifChannel": "notifications_disabled",
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "type": "command"
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "worktree": {
    "baseRef": "fresh"
  }
}
