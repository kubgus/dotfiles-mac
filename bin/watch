#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 [-a|--audio] <url>"
  exit 1
}

AUDIO_ONLY=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--audio) AUDIO_ONLY=1; shift ;;
    -h|--help) usage ;;
    -*) echo "Unknown option: $1" >&2; usage ;;
    *) break ;;
  esac
done

[[ $# -eq 1 ]] || usage
URL="$1"

if ! command -v mpv >/dev/null 2>&1; then
  echo "Error: mpv not found. Install it first (e.g., brew install mpv)." >&2
  exit 1
fi

if ! command -v yt-dlp >/dev/null 2>&1; then
  echo "Error: yt-dlp not found. Install it first (e.g., brew install yt-dlp)." >&2
  exit 1
fi

if [[ "$AUDIO_ONLY" -eq 1 ]]; then
  mpv "$(yt-dlp -f bestaudio --get-url "$URL")"
else
  mpv "$(yt-dlp -f best --get-url "$URL")"
fi
