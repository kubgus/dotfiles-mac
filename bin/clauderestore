#!/bin/bash
# Make every Claude Code desktop session ever created on this device show up
# under the account that is currently logged in.
#
# The desktop app's "Code" recents list is scoped per Anthropic account. The
# sessions themselves are CLI transcripts under ~/.claude/projects/; what the
# app lists are thin pointer files at
#   ~/Library/Application Support/Claude/claude-code-sessions/<account>/<workspace>/local_<uuid>.json
# so switching login does not move anything, it just stops the old account's
# pointers being read. This copies every other account's pointers into the
# current account's active workspace, and the whole history lists again.
#
# Non-destructive: the originals under the other accounts are untouched and the
# current account's directory is backed up first, to the path it prints.
#
#   clauderestore                            dry run: show what would be copied
#   clauderestore --apply                    copy, after taking the backup
#   clauderestore --apply --account <uuid>   target an account explicitly
#
# After --apply, fully quit Claude (Cmd-Q) and reopen it: the list is cached in
# memory and will not pick the new pointers up on its own.
#
# Bash 3.2 compatible (macOS default). No associative arrays. Space-safe paths.
set -euo pipefail

SUP="$HOME/Library/Application Support/Claude"
STORE="$SUP/claude-code-sessions"
CFG="$SUP/config.json"

prog="${0##*/}"

die() {
    echo "$prog: $1" >&2
    exit 1
}

usage() {
    echo "usage: $prog [--apply] [--account <uuid>]"
    echo "  --apply            copy the pointers; without it, only report"
    echo "  --account <uuid>   target this account instead of the logged-in one"
}

apply=0
force_account=""
while [ $# -gt 0 ]; do
    case "$1" in
        --apply) apply=1 ;;
        --account) shift; force_account="${1:-}" ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; die "unknown argument: $1" ;;
    esac
    shift
done

[ -d "$STORE" ] || die "no desktop session store at $STORE - is the desktop app installed?"
command -v jq >/dev/null || die "jq is required"

# --- current logged-in account ---
if [ -n "$force_account" ]; then
    current="$force_account"
else
    current="$(jq -r '.lastKnownAccountUuid // empty' "$CFG" 2>/dev/null || true)"
fi
[ -n "$current" ] || die "could not determine the current account - log into the desktop app, or pass --account <uuid>"
[ -d "$STORE/$current" ] || die "account '$current' has no session dir yet - open the desktop app's Code tab once, then rerun"

# --- pick the active workspace under that account: the one with the newest pointer ---
# Space-safe: only numeric mtimes are compared, and every path stays quoted.
target_ws=""
best_mtime=-1
while IFS= read -r ws; do
    [ -d "$ws" ] || continue
    # newest local_*.json mtime in this workspace (0 if none)
    newest=0
    while IFS= read -r pointer; do
        [ -f "$pointer" ] || continue
        mtime="$(stat -f '%m' "$pointer" 2>/dev/null || echo 0)"
        [ "$mtime" -gt "$newest" ] && newest="$mtime"
    done < <(find "$ws" -maxdepth 1 -name 'local_*.json' 2>/dev/null)
    # prefer the workspace with the newest pointer; if all are empty, keep one anyway
    if [ "$newest" -gt "$best_mtime" ]; then
        best_mtime="$newest"
        target_ws="$ws"
    fi
done < <(find "$STORE/$current" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)

[ -n "$target_ws" ] && [ -d "$target_ws" ] \
    || die "the current account has no workspace dir - open the desktop app's Code tab once, then rerun"

echo "Current account : $current"
echo "Active workspace: $(basename "$target_ws")"
echo "Store           : $STORE"
echo

# --- collect the pointers held by the other accounts, deduplicated by basename ---
target_list="$(mktemp)"   # basenames already in the target workspace
seen_list="$(mktemp)"     # basenames queued by this run
src_list="$(mktemp)"      # full source paths to copy
trap 'rm -f "$target_list" "$seen_list" "$src_list"' EXIT

find "$target_ws" -maxdepth 1 -name 'local_*.json' -exec basename {} \; 2>/dev/null \
    | sort -u > "$target_list"

total=0
queued=0
skipped=0
while IFS= read -r pointer; do
    [ -f "$pointer" ] || continue
    total=$((total + 1))
    name="$(basename "$pointer")"
    if grep -Fxq "$name" "$target_list" || grep -Fxq "$name" "$seen_list"; then
        skipped=$((skipped + 1))
        continue
    fi
    echo "$name" >> "$seen_list"
    echo "$pointer" >> "$src_list"
    queued=$((queued + 1))
done < <(find "$STORE" -mindepth 3 -maxdepth 3 -name 'local_*.json' -not -path "$STORE/$current/*" 2>/dev/null)

echo "Sessions in other accounts : $total"
echo "Already present in target  : $skipped"
echo "New sessions to restore    : $queued"

if [ "$apply" -ne 1 ]; then
    echo
    echo "Dry run. Re-run with --apply to copy the $queued new session(s) into the current account."
    exit 0
fi

# --- back up, then apply ---
backup="$HOME/.claude/desktop-session-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$backup"
cp -R "$STORE/$current" "$backup/current-account-before" 2>/dev/null || true
echo
echo "Backup of current account dir -> $backup"

copied=0
while IFS= read -r pointer; do
    [ -f "$pointer" ] || continue
    cp -n "$pointer" "$target_ws/" && copied=$((copied + 1))
done < "$src_list"

echo "Copied $copied new session pointer(s)."
echo "Target now holds: $(find "$target_ws" -maxdepth 1 -name 'local_*.json' | wc -l | tr -d ' ') sessions."
echo
echo "Next: fully quit Claude (Cmd-Q, not just the window) and reopen the Code tab."
echo "Undo: restore \"$backup/current-account-before\" over \"$STORE/$current\" (remove the copied local_*.json first)."
