#!/usr/bin/env python3
"""clc - choose which Claude Code account to run as, then launch it.

An account is nothing but a CLAUDE_CONFIG_DIR. Claude Code derives its Keychain
item name from a hash of that path, so pointing the env var somewhere else is
the whole of the account switch: separate credentials, separate identity, no
logging out and back in. This script only ever *reads* the Keychain.

The switch is meant not to be felt. Every entry in ~/.claude is symlinked into
each account except the handful that genuinely cannot be shared, so agents,
skills, commands, plugins, transcripts, prompt history, file history, running
sessions and background jobs are one set of files whichever account is active -
and anything a future version drops in there is shared too, without this list
needing to know about it.

~/.claude.json cannot be symlinked, because it holds the account's identity
next to all the preferences. It is synced key by key instead: the shared half
is pulled in before a session and pushed back after, so project trust, MCP
servers, onboarding and the rest follow you, while oauthAccount stays put. Last
writer wins if two accounts run at once, which is how that file already behaves
between concurrent sessions of one account.

An account is named by its email and nothing else. The directory under
~/.claude-accounts/ *is* the email, the list of accounts *is* what is in that
directory, and the name shown in the picker is read live from the account's own
.claude.json - so there is no second name to be kept in step. That path is what
the Keychain item is keyed on, which is why `add` asks for the email up front
rather than renaming afterwards: a rename would orphan the credentials. Change
the email on an account later and everything keeps working; only the directory
name goes stale, and it is a fallback that the live one overrides.

~/.claude itself is the first account, so the login that was there before this
script existed keeps working, and plain `claude` still uses it.

Usage percentages come from the same endpoint the /usage command uses, but only
when the account's stored access token is still valid; expired ones show the
last figure seen, with its age. Refreshing a token would mean writing new
credentials back to the Keychain, which this script deliberately does not do.

  clc [claude args...]     pick an account, then exec claude
  clc list                 print the accounts and their usage
  clc add <email>          create an account and sign it in
  clc rm <email>           sign an account out and delete it
  clc link                 re-apply the shared symlinks
  clc -- <args...>         pass args through even if they look like a verb
"""

import hashlib
import json
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
import unicodedata
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

HOME = os.path.expanduser("~")
SHARED_DIR = os.path.join(HOME, ".claude")
ROOT = os.environ.get("CLAUDE_PICK_HOME") or os.path.join(HOME, ".claude-accounts")
STATE_DIR = os.path.join(ROOT, ".state")
USAGE_CACHE = os.path.join(STATE_DIR, "usage.json")
LAST_FILE = os.path.join(STATE_DIR, "last")

USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
OAUTH_BETA = "oauth-2025-04-20"
FETCH_TIMEOUT = 6.0
LIVE_WINDOW = 120  # a reading younger than this reads as "live"
SKEW = 60  # treat a token expiring within a minute as already expired

# Everything in ~/.claude is shared except these. A denylist rather than an
# allowlist so that whatever a future version of Claude Code starts writing is
# shared by default - the way round that matches wanting not to feel the switch.
PRIVATE_ENTRIES = frozenset({
    # The daemon is a singleton per config dir, and these name its process.
    # Sharing them would have two daemons fighting over one lock.
    "daemon",
    "daemon.lock",
    "daemon.log",
    "daemon.status.json",
    # Fetched from whichever org the account belongs to.
    "policy-limits.json",
    "remote-settings.json",
    # Per-account queues, caches and lockfiles for live processes.
    "telemetry",
    "statsig",
    "ide",
    # Backups of the per-account .claude.json.
    "backups",
    ".last-cleanup",
    ".DS_Store",
})

# ~/.claude.json is one file holding both identity and preferences, so it is
# merged rather than linked. These keys stay with the account; everything else,
# including anything added later, follows you between them.
PRIVATE_CONFIG_KEYS = frozenset({
    "oauthAccount",
    "userID",
    "claudeCodeFirstTokenDate",
    "firstStartTime",
    "numStartups",
    # Caches scoped to the account's org or entitlements.
    "cachedGrowthBookFeatures",
    "cachedGrowthBookFeaturesAt",
    "cachedExperimentData",
    "cachedExperimentFeatures",
    "cachedExtraUsageDisabledReason",
    "modelAccessCache",
    "orgModelDefaultCache",
    "additionalModelOptionsCache",
    "additionalModelCostsCache",
    "autoCompactWindowsCache",
    "clientDataCacheSlots",
    "metricsStatusCache",
})

# Whatever name the command was invoked under, so advice quotes a command that
# actually exists on this machine rather than the file's name in the repo.
PROG = os.path.basename(sys.argv[0]) or "clc"

# Permissive about what an address may contain, strict about what would let one
# escape the accounts directory.
EMAIL_RE = re.compile(r"^[^\s/@]+@[^\s/@]+\.[^\s/@]+$")
KEYCHAIN_ACCOUNT_RE = re.compile(r"^[a-zA-Z0-9._-]+$")

VERBS = {"list", "ls", "add", "rm", "remove", "link", "help"}


# --------------------------------------------------------------------------
# terminal
# --------------------------------------------------------------------------


class Style:
    """ANSI codes, or empty strings when colour is not wanted."""

    def __init__(self, enabled):
        def code(seq):
            return seq if enabled else ""

        self.reset = code("\033[0m")
        self.bold = code("\033[1m")
        self.dim = code("\033[2m")
        self.accent = code("\033[36m")
        self.green = code("\033[32m")
        self.yellow = code("\033[33m")
        self.red = code("\033[31m")


def colour_wanted():
    return (
        sys.stdout.isatty()
        and "NO_COLOR" not in os.environ
        and os.environ.get("TERM", "") != "dumb"
    )


S = Style(colour_wanted())


def die(msg, code=1):
    sys.stderr.write("%s: %s\n" % (PROG, msg))
    raise SystemExit(code)


# --------------------------------------------------------------------------
# accounts
# --------------------------------------------------------------------------


def account_dir(account):
    """Absolute CLAUDE_CONFIG_DIR, or None for the default ~/.claude account."""
    return account["dir"]


def account_key(account):
    """Stable key for cached state: the config dir, empty string for default.

    Keyed on the path rather than the email because the path is what the
    account actually is - the email can change under it.
    """
    return account_dir(account) or ""


def discover_accounts():
    """Every account there is: ~/.claude, then each directory under ROOT.

    The filesystem is the list. There is no register to fall out of step with
    what is actually on disk.
    """
    accounts = [{"dir": None}]
    try:
        names = sorted(os.listdir(ROOT))
    except OSError:
        names = []
    for name in names:
        path = os.path.join(ROOT, name)
        if not name.startswith(".") and os.path.isdir(path):
            accounts.append({"dir": path})
    return accounts


def read_json(path, fallback=None):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return fallback


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


# --------------------------------------------------------------------------
# credentials (read only)
# --------------------------------------------------------------------------


def keychain_service(config_dir):
    """The Keychain service name Claude Code uses for a given config dir.

    Mirrors the CLI: "Claude Code-credentials", suffixed with the first eight
    hex digits of sha256(NFC(CLAUDE_CONFIG_DIR)) whenever the env var is set.
    """
    base = "Claude Code-credentials"
    if config_dir is None:
        return base
    normalised = unicodedata.normalize("NFC", config_dir)
    digest = hashlib.sha256(normalised.encode("utf-8")).hexdigest()[:8]
    return "%s-%s" % (base, digest)


def keychain_account():
    name = os.environ.get("USER") or ""
    return name if KEYCHAIN_ACCOUNT_RE.match(name) else "claude-code-user"


def read_token(config_dir):
    """(access_token, expires_at_seconds) from the Keychain, or (None, None).

    The token is returned for an immediate HTTPS call and never cached, logged
    or written anywhere.
    """
    cmd = [
        "security",
        "find-generic-password",
        "-a",
        keychain_account(),
        "-w",
        "-s",
        keychain_service(config_dir),
    ]
    try:
        proc = subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10
        )
    except (OSError, subprocess.SubprocessError):
        return None, None
    if proc.returncode != 0 or not proc.stdout:
        return None, None
    try:
        oauth = json.loads(proc.stdout.decode("utf-8").strip())["claudeAiOauth"]
        return oauth.get("accessToken"), (oauth.get("expiresAt") or 0) / 1000.0
    except (ValueError, KeyError, AttributeError, TypeError):
        return None, None


def signed_in(config_dir):
    token, _ = read_token(config_dir)
    return token is not None


# --------------------------------------------------------------------------
# usage
# --------------------------------------------------------------------------


def fetch_usage(config_dir):
    """Live usage for one account, or None when its token has expired.

    Deliberately gives up rather than refreshing: a refresh rotates the stored
    credentials, and this script does not write to the Keychain.
    """
    token, expires_at = read_token(config_dir)
    if not token or not expires_at or expires_at - SKEW <= time.time():
        return None
    request = urllib.request.Request(
        USAGE_URL,
        headers={
            "Authorization": "Bearer %s" % token,
            "anthropic-beta": OAUTH_BETA,
            "Content-Type": "application/json",
            "User-Agent": "clc",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=FETCH_TIMEOUT) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, OSError, ValueError):
        return None

    def slice_of(key):
        block = payload.get(key)
        if not isinstance(block, dict) or block.get("utilization") is None:
            return None
        return {
            "percent": float(block["utilization"]),
            "resets_at": block.get("resets_at"),
        }

    return {"at": time.time(), "five_hour": slice_of("five_hour"), "seven_day": slice_of("seven_day")}


def collect_usage(accounts, refresh=True):
    """Cached usage per account, topped up with whatever can be fetched."""
    cache = read_json(USAGE_CACHE, {}) or {}
    if not refresh:
        return cache

    with ThreadPoolExecutor(max_workers=max(1, len(accounts))) as pool:
        fetched = list(pool.map(lambda a: fetch_usage(account_dir(a)), accounts))

    changed = False
    for account, fresh in zip(accounts, fetched):
        if fresh:
            cache[account_key(account)] = fresh
            changed = True
    if changed:
        try:
            write_json(USAGE_CACHE, cache)
        except OSError:
            pass
    return cache


def remember_usage(account):
    """Cache one account's usage. Called after a session, when the token is new."""
    fresh = fetch_usage(account_dir(account))
    if not fresh:
        return
    cache = read_json(USAGE_CACHE, {}) or {}
    cache[account_key(account)] = fresh
    try:
        write_json(USAGE_CACHE, cache)
    except OSError:
        pass


# --------------------------------------------------------------------------
# identity
# --------------------------------------------------------------------------


def config_json_path(config_dir):
    return os.path.join(config_dir or HOME, ".claude.json")


def identity(account):
    """Who an account belongs to, read straight out of its own .claude.json.

    The email is the account's name; the org and plan are the supporting detail
    beside it.
    """
    config_dir = account_dir(account)
    if config_dir is not None and not os.path.isdir(config_dir):
        return {"state": "missing", "detail": "directory missing"}
    if not signed_in(config_dir):
        return {"state": "logged-out", "detail": "not signed in"}

    oauth = (read_json(config_json_path(config_dir), {}) or {}).get("oauthAccount") or {}
    plan = oauth.get("subscriptionType") or oauth.get("seatTier")
    parts = [oauth.get("organizationName")]
    if plan:
        parts.append(str(plan).replace("_", " "))
    detail = " · ".join(p for p in parts if p)
    email = oauth.get("emailAddress")
    return {"state": "ok", "email": email, "detail": detail or ("" if email else "signed in")}


def display_name(account, ident):
    """The live email, falling back to the directory it is stored in."""
    config_dir = account_dir(account)
    if config_dir is None:
        return ident.get("email") or "~/.claude"
    return ident.get("email") or os.path.basename(config_dir)


def build_rows(accounts, refresh=True):
    with ThreadPoolExecutor(max_workers=max(1, len(accounts))) as pool:
        identities = list(pool.map(identity, accounts))
    cache = collect_usage(accounts, refresh=refresh)
    return {
        account_key(account): {
            "identity": ident,
            "name": display_name(account, ident),
            "usage": cache.get(account_key(account)),
        }
        for account, ident in zip(accounts, identities)
    }


def resolve(accounts, rows, wanted):
    """Find the account someone means by an email.

    Matches the live email first and the directory name second, so an account
    created before this script named directories by email is still reachable by
    the address it actually belongs to.
    """
    wanted = wanted.strip().lower()
    for account in accounts:
        if rows[account_key(account)]["name"].lower() == wanted:
            return account
    for account in accounts:
        config_dir = account_dir(account)
        if config_dir and os.path.basename(config_dir).lower() == wanted:
            return account
    return None


# --------------------------------------------------------------------------
# formatting
# --------------------------------------------------------------------------

ANSI_RE = re.compile(r"\033\[[0-9;?]*[a-zA-Z]")


def pad(text, width):
    """Left-justify by *visible* width, so styled text still lines up."""
    visible = len(ANSI_RE.sub("", text))
    return text + " " * max(0, width - visible)


def clip(text, width):
    return text if len(text) <= width else text[: max(1, width - 1)] + "…"


def fit(text, width):
    """Truncate to a visible width without cutting an escape sequence in half.

    A line that wraps would throw off how far the picker has to move the cursor
    back up to redraw, so every line is made to fit first.
    """
    if len(ANSI_RE.sub("", text)) <= width:
        return text
    kept, shown, i = [], 0, 0
    while i < len(text) and shown < width:
        match = ANSI_RE.match(text, i)
        if match:
            kept.append(match.group())
            i = match.end()
        else:
            kept.append(text[i])
            shown += 1
            i += 1
    kept.append(S.reset)
    return "".join(kept)


def bar(percent, width=12):
    filled = max(0, min(width, int(round(percent / 100.0 * width))))
    if percent >= 85:
        colour = S.red
    elif percent >= 60:
        colour = S.yellow
    else:
        colour = S.green
    return "%s%s%s%s%s" % (colour, "█" * filled, S.dim, "░" * (width - filled), S.reset)


def gauge(label, slice_):
    """A fixed 20-column "5h ████░░░░ 35%" cell, blank when there is no reading."""
    if not slice_:
        return "%s%s %s    -%s" % (S.dim, label, " " * 12, S.reset)
    return "%s%s%s %s %3d%%" % (S.dim, label, S.reset, bar(slice_["percent"]), round(slice_["percent"]))


def ago(seconds):
    seconds = int(max(0, seconds))
    if seconds < 60:
        return "%ds" % seconds
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh" % (seconds // 3600)
    return "%dd" % (seconds // 86400)


def until(iso):
    if not iso:
        return None
    try:
        when = datetime.fromisoformat(iso.replace("Z", "+00:00"))
    except ValueError:
        return None
    return ago((when - datetime.now(timezone.utc)).total_seconds())


def freshness(entry):
    if not entry:
        return "no reading yet"
    age = time.time() - entry.get("at", 0)
    return "live" if age < LIVE_WINDOW else "%s ago" % ago(age)


def usage_line(entry):
    entry = entry or {}
    five = gauge("5h", entry.get("five_hour"))
    week = gauge("wk", entry.get("seven_day"))
    return "%s   %s   %s%s%s" % (five, week, S.dim, freshness(entry), S.reset)


def detail_line(row):
    """The line under the highlighted account: what to do, or when limits reset."""
    state = row["identity"]["state"]
    if state == "logged-out":
        return "press s to sign this account in"
    if state == "missing":
        return "its directory is gone - run: %s link" % PROG
    entry = row["usage"]
    if not entry:
        return "no usage reading yet - one is recorded when a session ends"
    bits = []
    for label, key in (("5h", "five_hour"), ("week", "seven_day")):
        slice_ = entry.get(key)
        left = until(slice_["resets_at"]) if slice_ else None
        if left:
            bits.append("%s resets in %s" % (label, left))
    return " · ".join(bits) if bits else "no reset window reported"


# --------------------------------------------------------------------------
# picker
# --------------------------------------------------------------------------


# Arrows arrive as CSI normally and as SS3 when the terminal is in application
# cursor mode, which tmux and some terminals switch on.
ARROW_KEYS = {
    b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left",
    b"OA": "up", b"OB": "down", b"OC": "right", b"OD": "left",
}


def read_key(fd):
    """One keypress, read from the descriptor rather than through sys.stdin.

    An arrow key arrives as three bytes in one go. Reading the first through a
    buffered stream pulls all three into Python's buffer, where select cannot
    see the other two - so every arrow looked like a bare Escape and quit.
    """
    first = os.read(fd, 1)
    if first != b"\x1b":
        return first.decode("utf-8", "replace")
    # A bare Escape is just ESC; anything longer is a sequence already waiting.
    if not select.select([fd], [], [], 0.05)[0]:
        return "esc"
    return ARROW_KEYS.get(os.read(fd, 2), "esc")


CHROME_LINES = 5  # header + blank, then the detail line, a blank and the keys
ACCOUNT_LINES = 3  # name, usage, blank


def render_lines(accounts, rows, cursor, width, height):
    """The picker as a list of lines, sized to fit the terminal it is drawn in.

    Windowed rather than truncated when the list is taller than the terminal,
    and the header says so, because quietly hiding an account would read as not
    having one.
    """
    room = max(1, (height - 1 - CHROME_LINES) // ACCOUNT_LINES)
    if room >= len(accounts):
        first, shown = 0, len(accounts)
    else:
        shown = room
        first = min(max(cursor - room // 2, 0), len(accounts) - room)
    visible = accounts[first:first + shown]

    counted = "" if shown == len(accounts) else " (%d of %d)" % (shown, len(accounts))
    lines = ["  %sClaude Code%s %s· pick an account%s%s" % (S.bold, S.reset, S.dim, counted or "", S.reset), ""]

    # Emails vary in length, so size the column to what is actually there.
    name_width = min(34, max(14, max(len(rows[account_key(a)]["name"]) for a in visible)))

    for account in visible:
        row = rows[account_key(account)]
        selected = account is accounts[cursor]
        marker = "%s▸%s" % (S.accent, S.reset) if selected else " "
        name = pad(clip(row["name"], name_width), name_width)
        if selected:
            name = "%s%s%s" % (S.bold, name, S.reset)
        spare = max(0, width - name_width - 9)
        detail = clip(row["identity"].get("detail", ""), spare)
        lines.append("  %s %s  %s%s%s" % (marker, name, S.dim, detail, S.reset))
        lines.append("      %s" % usage_line(row["usage"]))
        lines.append("")

    lines.append("  %s%s%s" % (S.dim, detail_line(rows[account_key(accounts[cursor])]), S.reset))
    lines.append("")
    lines.append("  %s↑↓ move · enter launch · s sign in · r refresh · q quit%s" % (S.dim, S.reset))
    return [fit(line, width) for line in lines]


class Inline:
    """Draws a block where the cursor already is, and takes it back afterwards.

    The alternate screen would blank the terminal for as long as the picker is
    up; this leaves whatever was on screen above it alone.
    """

    def __init__(self, out):
        self.out = out
        self.height = 0

    def draw(self, lines):
        out = self.out
        if self.height:
            out.write("\033[%dA" % self.height)
        out.write("\r")
        for line in lines:
            out.write("\033[2K%s\n" % line)
        # A shorter block than last time leaves a tail behind; wipe it.
        leftover = self.height - len(lines)
        for _ in range(max(0, leftover)):
            out.write("\033[2K\n")
        if leftover > 0:
            out.write("\033[%dA" % leftover)
        self.height = len(lines)
        out.flush()

    def erase(self):
        if self.height:
            self.out.write("\033[%dA\r\033[J" % self.height)
            self.out.flush()
            self.height = 0


def pick(accounts, rows, start):
    """Draw the picker and return the chosen index, or None if cancelled."""
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    out = sys.stdout
    cursor = start
    block = Inline(out)
    out.write("\033[?25l")
    try:
        # cbreak, not raw: raw would also switch off output post-processing, and
        # every line after the first would stair-step across the screen.
        tty.setcbreak(fd)
        while True:
            size = shutil.get_terminal_size((100, 24))
            block.draw(render_lines(accounts, rows, cursor, size.columns, size.lines))
            key = read_key(fd)
            if key in ("q", "\x03", "\x04", "esc"):
                return None
            if key in ("up", "k"):
                cursor = (cursor - 1) % len(accounts)
            elif key in ("down", "j"):
                cursor = (cursor + 1) % len(accounts)
            elif key in ("\r", "\n"):
                return cursor
            elif key == "r":
                # Stays in cbreak throughout: the fetch never reads stdin, and
                # restoring echo would let a keystroke land in the middle of the
                # block and throw the redraw off.
                cache = collect_usage(accounts)
                for account in accounts:
                    rows[account_key(account)]["usage"] = cache.get(account_key(account))
            elif key == "s":
                return ("sign-in", cursor)
            elif key.isdigit() and key != "0" and int(key) <= len(accounts):
                return int(key) - 1
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        block.erase()
        out.write("\033[?25h")
        out.flush()


# --------------------------------------------------------------------------
# shared symlinks
# --------------------------------------------------------------------------


def link_shared(config_dir, report=True):
    """Point everything shareable in an account directory back at ~/.claude.

    Run before every session, not just at `add`, so an entry that appears in
    ~/.claude later is picked up without anyone having to remember to relink.
    """
    os.makedirs(config_dir, exist_ok=True)

    try:
        entries = sorted(os.listdir(SHARED_DIR))
    except OSError:
        entries = []

    for entry in entries:
        if entry in PRIVATE_ENTRIES:
            continue
        source = os.path.join(SHARED_DIR, entry)
        dest = os.path.join(config_dir, entry)
        if os.path.islink(dest):
            if os.readlink(dest) == source:
                continue
            os.unlink(dest)
        elif os.path.exists(dest):
            spare = dest + ".backup"
            if report:
                print("Backing up %s -> %s" % (dest, spare))
            shutil.move(dest, spare)
        os.symlink(source, dest)
        if report:
            print("Creating symlink %s -> %s" % (dest, source))

    prune_stale_links(config_dir, report)


def prune_stale_links(config_dir, report=True):
    """Drop links to shared entries that have since gone or turned private.

    Only ever unlinks a symlink that points into ~/.claude, so nothing an
    account owns outright can be caught by it.
    """
    try:
        entries = os.listdir(config_dir)
    except OSError:
        return
    for entry in entries:
        dest = os.path.join(config_dir, entry)
        if not os.path.islink(dest):
            continue
        target = os.readlink(dest)
        if not target.startswith(SHARED_DIR + os.sep):
            continue
        if entry in PRIVATE_ENTRIES or not os.path.exists(target):
            os.unlink(dest)
            if report:
                print("Removing stale symlink %s" % dest)


def remove_account_dir(config_dir):
    """Delete an account directory without ever following a shared symlink.

    rmtree would not follow them either, but the shared entries point straight
    at ~/.claude, so this unlinks them explicitly rather than relying on that.
    """
    for name in os.listdir(config_dir):
        entry = os.path.join(config_dir, name)
        if os.path.islink(entry):
            os.unlink(entry)
        elif os.path.isdir(entry):
            shutil.rmtree(entry)
        else:
            os.remove(entry)
    os.rmdir(config_dir)


def split_config(shared_from, private_from):
    """One .claude.json: shared keys from the first, account keys from the second."""
    merged = {k: v for k, v in shared_from.items() if k not in PRIVATE_CONFIG_KEYS}
    merged.update({k: v for k, v in private_from.items() if k in PRIVATE_CONFIG_KEYS})
    return merged


def sync_config_in(config_dir):
    """Bring the shared half of ~/.claude.json into this account before a session.

    A fresh account gets everything but the identity keys, which is also how it
    skips onboarding and inherits the directories already trusted.
    """
    if config_dir is None:  # the default account already is ~/.claude.json
        return
    master = read_json(config_json_path(None))
    if not isinstance(master, dict):
        return
    target = config_json_path(config_dir)
    mine = read_json(target, {})
    write_json(target, split_config(master, mine if isinstance(mine, dict) else {}))


def sync_config_out(config_dir):
    """Push the shared half back to ~/.claude.json once the session is over."""
    if config_dir is None:
        return
    mine = read_json(config_json_path(config_dir))
    master_path = config_json_path(None)
    master = read_json(master_path)
    # Refuse rather than overwrite a file that would not parse - it is the one
    # copy every account pulls from.
    if not isinstance(mine, dict) or not isinstance(master, dict):
        return
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        shutil.copyfile(master_path, os.path.join(STATE_DIR, "claude.json.bak"))
    except OSError:
        pass
    write_json(master_path, split_config(mine, master))


# --------------------------------------------------------------------------
# launching
# --------------------------------------------------------------------------


def claude_binary():
    me = os.path.realpath(__file__)
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "claude")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            if os.path.realpath(candidate) != me:
                return candidate
    die("claude is not on PATH")


def account_env(account, name):
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)
    config_dir = account_dir(account)
    if config_dir:
        env["CLAUDE_CONFIG_DIR"] = config_dir
    # Handy for statuslines and hooks that want to show which account is live.
    env["CLAUDE_PICK_ACCOUNT"] = name
    return env


def run_as(account, name, args):
    """Run a command as an account and return its exit code.

    Ctrl-C belongs to the child: the parent just keeps waiting rather than
    tearing the session down from underneath it.
    """
    proc = subprocess.Popen([claude_binary()] + list(args), env=account_env(account, name))
    while True:
        try:
            return proc.wait()
        except KeyboardInterrupt:
            continue


def adopt(account):
    """Bring an account level with the shared state before handing it the terminal."""
    config_dir = account_dir(account)
    if config_dir is None:
        return
    link_shared(config_dir, report=False)
    sync_config_in(config_dir)


def settle(account):
    """Fold whatever the session changed back into the shared state."""
    config_dir = account_dir(account)
    if config_dir is not None:
        sync_config_out(config_dir)


def launch(account, name, args):
    # Nothing here is worth failing a launch over, so a broken sync is silent.
    try:
        adopt(account)
    except OSError:
        pass
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(LAST_FILE, "w", encoding="utf-8") as fh:
            fh.write(account_key(account))
    except OSError:
        pass

    code = run_as(account, name, args)

    try:
        settle(account)
        # The token was just refreshed by the session, so this reading is free.
        remember_usage(account)
    except Exception:  # never let bookkeeping change the exit code
        pass
    return code


def sign_in(account, name):
    try:
        adopt(account)
    except OSError:
        pass
    code = run_as(account, name, ["auth", "login"])
    try:
        settle(account)
    except Exception:
        pass
    return code


def sign_out(account, name):
    return run_as(account, name, ["auth", "logout"])


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------


def cmd_list(accounts):
    rows = build_rows(accounts)
    for account in accounts:
        row = rows[account_key(account)]
        where = (account_dir(account) or SHARED_DIR).replace(HOME, "~")
        detail = " · ".join(b for b in (row["identity"].get("detail"), where) if b)
        print("  %-32s %s%s%s" % (row["name"], S.dim, detail, S.reset))
        print("      %s" % usage_line(row["usage"]))
    return 0


def cmd_add(argv):
    if len(argv) != 1:
        die("usage: %s add <email>   (the address becomes the directory, so it "
            "has to be known before signing in)" % PROG)
    email = argv[0].strip()
    if not EMAIL_RE.match(email) or email.startswith("."):
        die("that does not look like an email address: %r" % argv[0])

    config_dir = os.path.join(ROOT, email)
    if os.path.exists(config_dir):
        die("%s is already an account - run: %s list" % (email, PROG))

    link_shared(config_dir)  # sign_in pulls the shared config in after this
    account = {"dir": config_dir}
    print("\nAdded %s. Signing in...\n" % config_dir.replace(HOME, "~"))
    code = sign_in(account, email)

    # The directory name is a claim about who signed in; check it held.
    actual = identity(account).get("email")
    if actual and actual.lower() != email.lower():
        print(
            "\n%s: signed in as %s, but the directory says %s. Everything works "
            "- the picker shows the real address - but the two disagree. To fix "
            "it: %s rm %s, then %s add %s\n"
            % (PROG, actual, email, PROG, email, PROG, actual),
            file=sys.stderr,
        )
    return code


def cmd_rm(accounts, argv):
    if len(argv) != 1:
        die("usage: %s rm <email>" % PROG)
    rows = build_rows(accounts, refresh=False)
    account = resolve(accounts, rows, argv[0])
    if not account:
        die("no account for %r - run: %s list" % (argv[0], PROG))
    config_dir = account_dir(account)
    if config_dir is None:
        die("~/.claude is the account Claude Code uses on its own; sign it out "
            "with `claude auth logout` if you mean to")

    name = rows[account_key(account)]["name"]
    print("This signs %s out and deletes %s." % (name, config_dir.replace(HOME, "~")))
    print("Shared files are symlinks and are left alone; sessions and settings "
          "for this account are not.")
    if not sys.stdin.isatty():
        die("refusing to delete without a terminal to confirm at")
    if input("Type the address to confirm: ").strip().lower() != name.lower():
        die("not confirmed, nothing removed")

    # Logging out is what releases the Keychain item; deleting the directory on
    # its own would leave the credentials behind with nothing pointing at them.
    if rows[account_key(account)]["identity"]["state"] == "ok":
        sign_out(account, name)
    remove_account_dir(config_dir)
    print("Removed %s." % name)
    return 0


def cmd_link(accounts):
    for account in accounts:
        config_dir = account_dir(account)
        if config_dir:
            link_shared(config_dir)
    return 0


def main(argv):
    accounts = discover_accounts()

    if argv and argv[0] == "--":
        argv = argv[1:]
    elif argv and argv[0] in VERBS:
        verb, rest = argv[0], argv[1:]
        if verb in ("list", "ls"):
            return cmd_list(accounts)
        if verb == "add":
            return cmd_add(rest)
        if verb in ("rm", "remove"):
            return cmd_rm(accounts, rest)
        if verb == "link":
            return cmd_link(accounts)
        print(__doc__.strip())
        return 0
    elif argv and argv[0] in ("-h", "--help") and len(argv) == 1:
        print(__doc__.strip())
        return 0

    if len(accounts) == 1:
        return launch(accounts[0], display_name(accounts[0], identity(accounts[0])), argv)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die("no terminal to draw the picker in; try: %s list" % PROG)

    try:
        with open(LAST_FILE, "r", encoding="utf-8") as fh:
            last = fh.read().strip()
    except OSError:
        last = None
    start = next((i for i, a in enumerate(accounts) if account_key(a) == last), 0)

    rows = build_rows(accounts)
    choice = pick(accounts, rows, start)
    if choice is None:
        return 130
    if isinstance(choice, tuple):
        account = accounts[choice[1]]
        return sign_in(account, rows[account_key(account)]["name"])
    account = accounts[choice]
    return launch(account, rows[account_key(account)]["name"], argv)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
