#!/bin/bash
# Install a Steam game's macOS build with the native (Homebrew) steamcmd, so
# no Steam client is needed to install it or to launch it afterwards.
#
# The AppID names the install directory, so what is under ~/Games matches what
# Steam calls the game:
#
#   steamget 646570    installs to ~/Games/646570
#
# A copy installed under some other directory name - by hand, or by the version
# of this script that took one - is found by its manifest and moved into place
# rather than downloaded again.
#
# The Steam account comes from $STEAM_USERNAME and is asked for when unset, so
# the name stays out of the repo. A first run also prompts for the password
# and, most likely, a Steam Guard code sent to email or the Steam mobile app.
set -euo pipefail

GAMES_DIR="$HOME/Games"

prog="${0##*/}"

die() {
    echo "$prog: $1" >&2
    exit 1
}

usage() {
    echo "usage: $prog <appid>"
    echo "  appid    the game's Steam AppID, which also names the install dir"
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
esac

[ $# -eq 1 ] || { usage >&2; exit 1; }

command -v steamcmd >/dev/null 2>&1 \
    || die "steamcmd not found - install it with: brew install steamcmd"

appid="$1"
install_dir="$GAMES_DIR/$appid"

# steamcmd writes a manifest inside whatever it was given as force_install_dir,
# so an install can be identified by AppID whatever its directory ended up
# called. Without this, a copy sitting under a name would go unseen and the
# whole game would be fetched a second time beside it.
adopt_existing_install() {
    local manifest dir here=0 strays=0 stray=""

    # Decide after the whole walk, never inside it: two copies of one AppID
    # would otherwise be resolved differently depending on which directory name
    # the glob happened to reach first.
    for manifest in "$GAMES_DIR"/*/steamapps/"appmanifest_$appid.acf"; do
        # An unmatched glob comes through as the pattern itself; bash 3.2 has no
        # nullglob worth relying on here.
        [ -f "$manifest" ] || continue
        dir="${manifest%/steamapps/*}"
        if [ "$dir" = "$install_dir" ]; then
            here=1
        else
            strays=$((strays + 1))
            stray="$dir"
        fi
    done

    # Already where it belongs. A copy under another name is then only wasted
    # disk, and not something to move on top of a live install.
    if [ "$here" -eq 1 ]; then
        if [ "$strays" -eq 1 ]; then
            echo "$prog: this AppID is also installed at $stray - stale, safe to delete" >&2
        elif [ "$strays" -gt 1 ]; then
            echo "$prog: this AppID is also installed in $strays other directories under $GAMES_DIR" >&2
        fi
        return 0
    fi

    if [ "$strays" -eq 0 ]; then
        return 0
    fi
    if [ "$strays" -gt 1 ]; then
        die "AppID $appid is installed in $strays directories under $GAMES_DIR - keep one and remove the rest"
    fi

    # An empty target is a run that stopped before downloading anything.
    if [ -d "$install_dir" ]; then
        rmdir "$install_dir" 2>/dev/null || true
    fi
    if [ -e "$install_dir" ]; then
        die "$install_dir is in the way of moving $stray into place"
    fi

    echo "Found this AppID at $stray - moving it to $install_dir"
    mv "$stray" "$install_dir"
    return 0
}

adopt_existing_install

steam_username="${STEAM_USERNAME:-}"
if [ -z "$steam_username" ]; then
    read -r -p "Steam username: " steam_username
    [ -n "$steam_username" ] || die "no username given"
fi

mkdir -p "$install_dir"

# Clear the quarantine flag on steamcmd's own files and its data directory.
# Without this, macOS Gatekeeper can pop up "damaged and can't be opened"
# dialogs the first time steamcmd extracts certain framework files.
xattr -rd com.apple.quarantine /opt/homebrew/Caskroom/steamcmd 2>/dev/null || true
xattr -rd com.apple.quarantine "$HOME/Library/Application Support/Steam" 2>/dev/null || true

echo "Installing AppID $appid (macOS build) into: $install_dir"
echo

steamcmd \
    +@sSteamCmdForcePlatformType macos \
    +force_install_dir "$install_dir" \
    +login "$steam_username" \
    +app_update "$appid" validate \
    +quit

# Whatever bundle came out of that, make sure it can actually be launched.
find "$install_dir" -maxdepth 1 -iname "*.app" -print0 2>/dev/null \
    | while IFS= read -r -d '' app; do
        chmod -R +x "$app/Contents/MacOS" 2>/dev/null || true
    done

echo
echo "Done. Files are in: $install_dir"

app_bundle=$(find "$install_dir" -maxdepth 1 -iname "*.app" 2>/dev/null | head -n 1)
if [ -n "$app_bundle" ]; then
    echo "Launch with:"
    echo "  open \"$app_bundle\""
else
    echo "No .app bundle at the top level - look in $install_dir for the game's executable."
fi
