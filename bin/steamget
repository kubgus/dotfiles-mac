#!/usr/bin/env bash
#
# steamget <appid>
#
# Installs a Steam game's macOS build using the native (Homebrew) steamcmd,
# so no Steam client is needed to install or later launch the game.
#
# The AppID names the install directory, so ~/Games matches what Steam calls
# the game and a second copy of the same game cannot land beside the first:
#
#   steamget 646570    # installs to ~/Games/646570
#
# The Steam account is read from $STEAM_USERNAME and asked for when unset, so
# the name stays out of the repo. First run will also prompt for your password
# and, most likely, a Steam Guard code sent to your email or Steam Mobile app.

set -euo pipefail

STEAM_USERNAME="${STEAM_USERNAME:-}"
GAMES_DIR="$HOME/Games"

if [ $# -ne 1 ]; then
  echo "Usage: $0 <appid>"
  exit 1
fi

if ! command -v steamcmd >/dev/null 2>&1; then
  echo "steamcmd not found. Install it first with: brew install steamcmd"
  exit 1
fi

if [ -z "$STEAM_USERNAME" ]; then
  read -r -p "Steam username: " STEAM_USERNAME
  [ -n "$STEAM_USERNAME" ] || { echo "No username given."; exit 1; }
fi

APPID="$1"
INSTALL_DIR="$GAMES_DIR/$APPID"

mkdir -p "$INSTALL_DIR"

# Clear the quarantine flag on steamcmd's own files and its data directory.
# Without this, macOS Gatekeeper can pop up "damaged and can't be opened"
# dialogs the first time steamcmd extracts certain framework files.
xattr -rd com.apple.quarantine /opt/homebrew/Caskroom/steamcmd 2>/dev/null || true
xattr -rd com.apple.quarantine "$HOME/Library/Application Support/Steam" 2>/dev/null || true

echo "Installing AppID $APPID (macOS build) into: $INSTALL_DIR"
echo

steamcmd \
  +@sSteamCmdForcePlatformType macos \
  +force_install_dir "$INSTALL_DIR" \
  +login "$STEAM_USERNAME" \
  +app_update "$APPID" validate \
  +quit

# Make sure any .app bundle produced is executable.
find "$INSTALL_DIR" -maxdepth 1 -iname "*.app" -print0 2>/dev/null \
  | while IFS= read -r -d '' app; do
      chmod -R +x "$app/Contents/MacOS" 2>/dev/null || true
    done

echo
echo "Done. Files are in: $INSTALL_DIR"

APP_BUNDLE=$(find "$INSTALL_DIR" -maxdepth 1 -iname "*.app" 2>/dev/null | head -n 1)
if [ -n "$APP_BUNDLE" ]; then
  echo "Launch with:"
  echo "  open \"$APP_BUNDLE\""
else
  echo "No .app bundle found at the top level — check $INSTALL_DIR for the game's executable."
fi
