#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.9"
# ///
"""search - jump to a directory you marked earlier, from anywhere above it.

A directory becomes a destination once it holds a .search_marker file, so the
list you pick from is the one you built on purpose rather than every folder
in the tree. `search --add` places a marker; `search` picks one below the
working directory with fzf and prints it.

Printing is all this can do: a script on PATH runs in its own process and
cannot move the shell that called it. The `search` function in zprofile is
what turns the printed path into a cd.

So stdout carries the chosen directory and nothing else - usage, and the
confirmation from --add, go to stderr - and that function can take the whole
of stdout without having to tell a path from chatter.

The walk stops at a git repository: a marker at the repository's root is
offered, but nothing inside it is walked, which keeps node_modules, build
output and vendored trees out of the walk without a list of names to skip.
The directory the walk starts from is the exception, so search still works
from inside a repository.

This is Python rather than shell because of that stop. find can only test the
entry it is on, so knowing that a directory holds .git costs a process per
directory - minutes over a home directory - and a walker in bash is about ten
times slower than this one.
"""

import contextlib
import itertools
import os
import shutil
import subprocess
import sys

MARKER = ".search_marker"
DEPTH = 10  # levels below the starting directory, which is level 0

PROG = os.path.basename(sys.argv[0]) or "search"


def die(message):
    print(f"{PROG}: {message}", file=sys.stderr)
    raise SystemExit(1)


def usage():
    print(f"""usage: {PROG} [dir]
       {PROG} -a | --add [dir]

  -a, --add   mark dir as a destination and exit (default: .)
  -h, --help  show this

With no flag, pick a marked directory below dir (default: .) and print
it. The walk goes at most {DEPTH} levels down and does not enter a git
repository below dir, though a marker at its root is still offered.
Exits 1 when nothing below dir is marked.""", file=sys.stderr)


def add_marker(target):
    if not os.path.isdir(target):
        die(f"not a directory: {target}")
    path = os.path.join(target, MARKER)
    if os.path.exists(path):
        return
    open(path, "a").close()
    print(f"Marked {target}", file=sys.stderr)


def find_marked(directory, levels_left, is_start=False):
    """Yield each marked directory at or below directory, as it is found."""
    try:
        with os.scandir(directory) as it:
            entries = {entry.name: entry for entry in it}
    except OSError:
        # An unreadable directory is no reason to fail a pick.
        return
    if MARKER in entries:
        yield directory
    if levels_left == 0 or (".git" in entries and not is_start):
        return
    for entry in entries.values():
        if entry.is_dir(follow_symlinks=False):
            yield from find_marked(entry.path, levels_left - 1)


def display(path):
    return path[2:] if path.startswith("./") else path


def pick(root):
    marked = find_marked(root, DEPTH, is_start=True)

    # Taking the first match before fzf starts is what keeps an empty tree
    # distinguishable from a pick that matched nothing - fzf leaves with 1
    # either way.
    first = next(marked, None)
    if first is None:
        die(f"nothing marked within {DEPTH} levels of {root} - mark a directory with: {PROG} --add")

    # fzf draws as input arrives, so the walk streams into it rather than being
    # collected first: the picker is up and usable while the walk goes on.
    fzf = subprocess.Popen(
        ["fzf", "--height=40%", "--reverse", "--prompt=Search > "],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        text=True,
    )
    # A broken pipe means fzf left before the walk finished: the pick is made,
    # and the rest of the walk is not needed.
    with contextlib.suppress(BrokenPipeError):
        for path in itertools.chain([first], marked):
            fzf.stdin.write(display(path) + "\n")
            fzf.stdin.flush()
    with contextlib.suppress(BrokenPipeError):
        fzf.stdin.close()

    selected = fzf.stdout.read()
    status = fzf.wait()
    if status != 0:
        return status
    sys.stdout.write(selected)
    return 0


def main(args):
    if args and args[0] in ("-h", "--help"):
        usage()
        return 0
    if args and args[0] in ("-a", "--add"):
        add_marker(args[1] if len(args) > 1 else ".")
        return 0

    root = None
    for arg in args:
        if arg.startswith("-"):
            die(f"unknown flag: {arg}")
        if root is not None:
            die(f"only one directory, got '{root}' and '{arg}'")
        root = arg
    if root is None:
        root = "."

    if not os.path.isdir(root):
        die(f"not a directory: {root}")
    if shutil.which("fzf") is None:
        die("fzf not found - install it with: brew install fzf")

    # Instant feedback, rather than a pause before the picker appears.
    print("Searching...", end="\r", file=sys.stderr, flush=True)
    return pick(root)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
