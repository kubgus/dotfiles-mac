#!/bin/bash
# Bring Claude to the front and confirm whatever permission prompt is waiting,
# so a prompt can be answered without leaving the app you are working in.
#
# Bind this to a system-wide key in Shortcuts.app (Run Shell Script action).
#
# Cmd-Return lands on whatever Claude happens to be showing, so this confirms
# without you reading the prompt first. It is meant to answer a request you
# just heard announced by speak.sh - not to approve blind. With nothing
# pending the keystroke still goes through, to whatever has focus in Claude.
set -euo pipefail

osascript - <<'APPLESCRIPT'
tell application "Claude" to activate

-- Give the window a moment to come forward before typing into it.
delay 0.2

tell application "System Events"
  tell process "Claude"
    set frontmost to true
    keystroke return using command down
  end tell
end tell
APPLESCRIPT
